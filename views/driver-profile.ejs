<%- include('partials/head', { title: 'Driver & Vehicle Profile' }) %>
<%- include('partials/navbar', { activePage: 'profile' }) %>

<main style="padding: 2.5rem 0 4rem;">
  <div class="container" style="max-width: 800px;">
    <%- include('partials/flash') %>

    <!-- PAGE HEADER -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
      <div>
        <div style="display: flex; align-items: center; gap: 10px;">
          <h1 style="font-size: 1.85rem; color: var(--primary-900); margin: 0;">
            Driver & Van Profile
          </h1>
          <% if (driver.verificationStatus === 'verified') { %>
            <span class="badge badge-active">✓ Verified Driver</span>
          <% } else { %>
            <span class="badge badge-pending">● Verification Pending</span>
          <% } %>
        </div>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">
          Keep your contact information, license, and vehicle seating specifications up to date.
        </p>
      </div>

      <a href="/driver/dashboard" class="btn btn-outline btn-sm">
        &larr; Back to Dashboard
      </a>
    </div>

    <!-- PROFILE FORM CARD -->
    <div class="card" style="padding: 2.25rem;">
      <form action="/driver/profile" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- PERSONAL INFORMATION -->
        <div style="font-size: 1.05rem; font-weight: 700; color: var(--primary-900); padding-bottom: 0.75rem; border-bottom: 2px solid var(--border-subtle); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 8px;">
          <span>👤</span> Personal & Contact Details
        </div>

        <div class="form-group">
          <label for="name" class="form-label">Full Legal Name *</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            class="form-input" 
            value="<%= driver.name %>" 
            required 
          />
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
          <div class="form-group" style="margin: 0;">
            <label for="email" class="form-label">Email Address (Account ID)</label>
            <input 
              type="email" 
              id="email" 
              class="form-input" 
              value="<%= driver.email %>" 
              disabled 
              style="background: var(--bg-alt); color: var(--text-muted); cursor: not-allowed;"
            />
            <span class="form-help">Account login identifier cannot be changed directly.</span>
          </div>

          <div class="form-group" style="margin: 0;">
            <label for="phone" class="form-label">Phone Number *</label>
            <input 
              type="tel" 
              id="phone" 
              name="phone" 
              class="form-input" 
              value="<%= driver.phone %>" 
              required 
            />
            <span class="form-help">Used by tourists to call or WhatsApp you regarding trips.</span>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
          <div class="form-group" style="margin: 0;">
            <label for="licenseNumber" class="form-label">Driver License Number *</label>
            <input 
              type="text" 
              id="licenseNumber" 
              name="licenseNumber" 
              class="form-input" 
              value="<%= driver.licenseNumber %>" 
              required 
            />
          </div>

          <div class="form-group" style="margin: 0;">
            <label for="experienceYears" class="form-label">Driving Experience (Years) *</label>
            <input 
              type="number" 
              id="experienceYears" 
              name="experienceYears" 
              class="form-input" 
              min="0" 
              max="60" 
              value="<%= driver.experienceYears %>" 
              required 
            />
          </div>
        </div>

        <!-- VEHICLE SPECIFICATIONS -->
        <div style="font-size: 1.05rem; font-weight: 700; color: var(--primary-900); padding-bottom: 0.75rem; border-bottom: 2px solid var(--border-subtle); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 8px;">
          <span>🚐</span> Vehicle Specifications
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
          <div class="form-group" style="margin: 0;">
            <label for="vanModel" class="form-label">Van Make & Model *</label>
            <input 
              type="text" 
              id="vanModel" 
              name="vanModel" 
              class="form-input" 
              placeholder="e.g. Toyota HiAce, Force Urbania" 
              value="<%= driver.vanModel %>" 
              required 
            />
          </div>

          <div class="form-group" style="margin: 0;">
            <label for="vanNumber" class="form-label">Vehicle Registration / Plate Number *</label>
            <input 
              type="text" 
              id="vanNumber" 
              name="vanNumber" 
              class="form-input" 
              placeholder="e.g. DL-01-AB-1234" 
              value="<%= driver.vanNumber %>" 
              required 
            />
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 2rem;">
          <label for="seatingCapacity" class="form-label">Passenger Seating Capacity (Seats: 4 - 20) *</label>
          <input 
            type="number" 
            id="seatingCapacity" 
            name="seatingCapacity" 
            class="form-input" 
            min="4" 
            max="20" 
            value="<%= driver.seatingCapacity %>" 
            required 
          />
          <span class="form-help">Only tourist trips requesting passenger counts up to this capacity will match your profile.</span>
        </div>

        <div style="padding-top: 1rem; border-top: 1px solid var(--border-subtle); display: flex; justify-content: flex-end;">
          <button type="submit" class="btn btn-primary" style="padding: 0.85rem 2rem; font-size: 1rem;">
            💾 Save Profile Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
