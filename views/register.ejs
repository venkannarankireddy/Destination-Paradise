<%- include('partials/head', { title: 'Create Traveler Account' }) %>
<%- include('partials/navbar', { activePage: 'register' }) %>

<main style="padding: 3.5rem 0; min-height: 75vh; display: flex; align-items: center;">
  <div class="container container-narrow">
    <div class="card" style="max-width: 460px; margin: 0 auto; padding: 2.5rem; box-shadow: var(--shadow-md);">
      <div style="text-align: center; margin-bottom: 2rem;">
        <div class="brand-icon" style="margin: 0 auto 1rem; width: 48px; height: 48px; font-size: 1.5rem;">
          🌴
        </div>
        <h1 style="font-size: 1.6rem; color: var(--primary-900);">Create Traveler Account</h1>
        <p style="font-size: 0.92rem; color: var(--text-muted); margin-top: 4px;">
          Join Destination Paradise to request vacation van trips and connect with local drivers.
        </p>
      </div>

      <%- include('partials/flash') %>

      <form action="/register" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="name@example.com" required autocomplete="email" />
          <div class="form-hint">Used for receiving trip status updates and login.</div>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="Minimum 6 characters" required minlength="6" autocomplete="new-password" />
          <div class="form-hint">Must be at least 6 characters.</div>
        </div>

        <div style="margin-top: 1.5rem;">
          <button type="submit" class="btn btn-primary btn-block btn-lg">
            Create Traveler Account
          </button>
        </div>
      </form>

      <div style="margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); text-align: center;">
        <p style="font-size: 0.9rem; color: var(--text-muted);">
          Already registered? 
          <a href="/login" style="font-weight: 700; color: var(--primary-600);">Sign in here</a>
        </p>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin-top: 0.75rem;">
          Want to offer your van for trips? 
          <a href="/driver/register" style="font-weight: 700; color: var(--teal-600);">Register as a Van Driver &rarr;</a>
        </p>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
