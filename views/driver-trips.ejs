<%- include('partials/head', { title: 'Trip Requests Marketplace' }) %>
<%- include('partials/navbar', { activePage: 'trips' }) %>

<main style="padding: 2.5rem 0 4rem;">
  <div class="container">
    <%- include('partials/flash') %>

    <!-- PAGE HEADER -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
      <div>
        <h1 style="font-size: 1.85rem; color: var(--primary-900);">
          Trip Requests Marketplace
        </h1>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">
          Browse tourist long-distance travel requests matching your scheduled availability and van seating capacity.
        </p>
      </div>

      <div style="display: flex; gap: 10px;">
        <a href="/driver/availability" class="btn btn-outline btn-sm">
          📅 Manage Availability
        </a>
        <a href="/driver/my-trips" class="btn btn-secondary btn-sm">
          📋 My Accepted Trips
        </a>
      </div>
    </div>

    <!-- DIRECT COMMUNCATION ADVISORY BANNER -->
    <div class="card" style="margin-bottom: 2rem; border-left: 5px solid var(--secondary-500); background: #fdfaf6;">
      <div style="display: flex; align-items: flex-start; gap: 14px;">
        <div style="font-size: 1.8rem; line-height: 1;">📢</div>
        <div>
          <h3 style="font-size: 1.05rem; color: var(--primary-900); margin-bottom: 4px;">
            Direct Tourist-to-Driver Agreement Model
          </h3>
          <p style="font-size: 0.92rem; color: var(--text-secondary); line-height: 1.5; margin: 0;">
            Destination Paradise connects you directly with tourists. <strong>We do not process payments or collect commissions.</strong> 
            Always call or message the tourist first to confirm pickup details, itinerary, luggage capacity, and mutually agreed compensation before clicking <strong>Accept Trip</strong>.
          </p>
        </div>
      </div>
    </div>

    <!-- INACTIVE STATUS ALERT -->
    <% if (!driver.isActive) { %>
      <div class="card" style="margin-bottom: 2rem; border-left: 5px solid var(--danger); background: #fff5f5;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <div>
            <h3 style="font-size: 1.05rem; color: #991b1b; margin-bottom: 4px;">
              ⚠️ You are currently Paused from Trip Matching
            </h3>
            <p style="font-size: 0.92rem; color: #7f1d1d; margin: 0;">
              Your driver status is set to inactive. Turn your profile on to see live matching trip requests from tourists.
            </p>
          </div>
          <form action="/driver/toggle-active" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-secondary btn-sm">
              ▶️ Activate Profile
            </button>
          </form>
        </div>
      </div>
    <% } %>

    <!-- FILTER BAR -->
    <div class="card" style="margin-bottom: 2.5rem; padding: 1.5rem;">
      <form action="/driver/trips" method="GET" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)) auto; gap: 1rem; align-items: flex-end;">
        <div class="form-group" style="margin: 0;">
          <label for="destination" class="form-label" style="font-size: 0.82rem;">Destination</label>
          <input 
            type="text" 
            id="destination" 
            name="destination" 
            class="form-input" 
            placeholder="e.g. Manali, Goa, Munnar..." 
            value="<%= filters.destination || '' %>"
          />
        </div>

        <div class="form-group" style="margin: 0;">
          <label for="fromDate" class="form-label" style="font-size: 0.82rem;">From Date</label>
          <input 
            type="date" 
            id="fromDate" 
            name="fromDate" 
            class="form-input" 
            value="<%= filters.fromDate || '' %>"
          />
        </div>

        <div class="form-group" style="margin: 0;">
          <label for="toDate" class="form-label" style="font-size: 0.82rem;">To Date</label>
          <input 
            type="date" 
            id="toDate" 
            name="toDate" 
            class="form-input" 
            value="<%= filters.toDate || '' %>"
          />
        </div>

        <div class="form-group" style="margin: 0;">
          <label for="people" class="form-label" style="font-size: 0.82rem;">Max Passengers</label>
          <input 
            type="number" 
            id="people" 
            name="people" 
            class="form-input" 
            min="1" 
            max="<%= driver.seatingCapacity %>" 
            placeholder="Up to <%= driver.seatingCapacity %>" 
            value="<%= filters.people || '' %>"
          />
        </div>

        <div style="display: flex; gap: 8px;">
          <button type="submit" class="btn btn-primary" style="height: 42px; padding: 0 1.25rem;">
            Filter
          </button>
          <a href="/driver/trips" class="btn btn-outline" style="height: 42px; display: inline-flex; align-items: center; padding: 0 1rem;">
            Reset
          </a>
        </div>
      </form>
    </div>

    <!-- MATCHING TRIPS LIST -->
    <% if (trips.length === 0) { %>
      <div class="empty-state">
        <div class="empty-state-icon">🚐</div>
        <h3 class="empty-state-title">No Matching Trip Requests</h3>
        <p class="empty-state-desc">
          <% if (!driver.isActive) { %>
            Your driver account is currently paused. Activate your profile to browse open trip requests from travelers.
          <% } else { %>
            There are currently no open trip requests that fit within your scheduled availability windows and van capacity (<%= driver.seatingCapacity %> seats).
          <% } %>
        </p>
        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
          <a href="/driver/availability" class="btn btn-secondary">
            📅 Update Availability Dates
          </a>
          <% if (!driver.isActive) { %>
            <form action="/driver/toggle-active" method="POST" style="display:inline;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-primary">
                ▶️ Activate Profile
              </button>
            </form>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <div style="margin-bottom: 1.25rem; font-weight: 600; color: var(--text-secondary); display: flex; justify-content: space-between; align-items: center;">
        <span>
          Showing <strong><%= trips.length %></strong> matching trip request<%= trips.length === 1 ? '' : 's' %> for your <%= driver.vanModel %> (<%= driver.seatingCapacity %> seats)
        </span>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
        <% trips.forEach((trip) => { %>
          <% 
            const cleanPhone = (trip.countryCode || '') + (trip.phone || '');
            const waDigits = cleanPhone.replace(/[^0-9]/g, '');
          %>
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; border-top: 4px solid var(--secondary-500);">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 1rem;">
                <h3 style="font-size: 1.25rem; color: var(--primary-900); margin: 0;">
                  🌴 <%= trip.destination %>
                </h3>
                <span class="badge badge-pending">🟡 Looking for Driver</span>
              </div>

              <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 1.25rem;">
                <div style="font-size: 0.95rem; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
                  <span>📅</span> <%= trip.fromDate %> &rarr; <%= trip.toDate %>
                </div>
                <div style="font-size: 0.9rem; color: var(--text-muted); display: flex; align-items: center; gap: 8px;">
                  <span>👥</span> <strong><%= trip.people %></strong> Passenger<%= trip.people === 1 ? '' : 's' %> (Fits in <%= driver.seatingCapacity %>-seat van)
                </div>
              </div>

              <!-- TOURIST CONTACT BOX -->
              <div style="background: var(--bg-alt); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1.25rem; border-left: 3px solid var(--secondary-500);">
                <div style="font-size: 0.72rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">
                  Tourist Details
                </div>
                <div style="font-size: 1rem; font-weight: 700; color: var(--primary-900); margin-bottom: 4px;">
                  <%= trip.name %>
                </div>
                <div style="font-size: 0.9rem; color: var(--text-secondary); display: flex; align-items: center; gap: 6px;">
                  <span>📞</span> <%= trip.countryCode %> <%= trip.phone %>
                </div>
              </div>
            </div>

            <div>
              <!-- DIRECT CONTACT ACTIONS -->
              <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                <a href="tel:<%= trip.countryCode %><%= trip.phone %>" class="btn btn-outline btn-sm" style="flex: 1; text-align: center;">
                  📞 Call Tourist
                </a>
                <% if (waDigits) { %>
                  <a href="https://wa.me/<%= waDigits %>?text=Hello%20<%= encodeURIComponent(trip.name) %>,%20I%20am%20a%20van%20driver%20on%20Destination%20Paradise%20interested%20in%20your%20trip%20to%20<%= encodeURIComponent(trip.destination) %>." target="_blank" class="btn btn-teal btn-sm" style="flex: 1; text-align: center;">
                    💬 WhatsApp
                  </a>
                <% } %>
              </div>

              <div style="font-size: 0.78rem; color: var(--text-muted); background: var(--bg-alt); padding: 6px 10px; border-radius: var(--radius-sm); margin-bottom: 10px; text-align: center; border: 1px dashed var(--border-subtle); line-height: 1.35;">
                Contact tourist directly to agree on pricing and trip details before accepting.
              </div>

              <!-- ACCEPT ACTION -->
              <form action="/driver/trips/<%= trip.id %>/accept" method="POST" onsubmit="return confirm('Have you contacted the tourist and agreed on the trip details and payment terms? Do you want to accept this trip?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-primary" style="width: 100%;">
                  🤝 Accept Trip
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
