<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>My Bookings</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      color: #333;
      padding: 2rem;
    }
    h2 {
      margin-bottom: 1rem;
    }
    button {
      background: #e91e63;
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      margin-bottom: 2rem;
    }
    button:hover {
      background: #c2185b;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    th, td {
      padding: 12px 16px;
      border: 1px solid #ddd;
      text-align: left;
    }
    th {
      background-color: #ffe4ec;
    }
  </style>
</head>
<body>
  <h2>Welcome, <%= user.email %></h2>
  <div style="display: flex; gap: 10px; margin-bottom: 2rem;">
    <button onclick="window.location.href='/'" style="background: #333;">&larr; Back to Home</button>
    <button onclick="window.location.href='/logout'">Logout</button>
  </div>

  <h2>Your Bookings</h2>

  <% if (bookings.length === 0) { %>
    <p>No bookings yet.</p>
  <% } else { %>
    <div style="overflow-x: auto; width: 100%; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.08);">
    <table>
  <thead>
    <tr>
      <th>Destination</th>
      <th>From</th>
      <th>To</th>
      <th>People</th>
      <th>Name</th>
      <th>Phone</th>
      <th>Status</th>
      <th>Assigned Driver & Vehicle</th>
      <th>Booked At</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% bookings.forEach((b) => { %>
      <tr>
        <td style="font-weight: 600;"><%= b.destination %></td>
        <td><%= b.fromDate %></td>
        <td><%= b.toDate %></td>
        <td><%= b.people %></td>
        <td><%= b.name %></td>
        <td><%= b.countryCode %> <%= b.phone %></td>
        <td>
          <% if (b.status === "Requested") { %>
            <span style="color:#92400e; font-weight:700; background:#fef3c7; padding:4px 8px; border-radius:12px; font-size:0.85rem; display:inline-block; white-space:nowrap;">
              🟡 Looking for Driver
            </span>
          <% } else if (b.status === "Accepted") { %>
            <span style="color:#166534; font-weight:700; background:#dcfce7; padding:4px 8px; border-radius:12px; font-size:0.85rem; display:inline-block; white-space:nowrap;">
              🟢 Driver Assigned
            </span>
          <% } else if (b.status === "Confirmed") { %>
            <span style="color:#15803d; font-weight:700; background:#f0fdf4; padding:4px 8px; border-radius:12px; font-size:0.85rem; display:inline-block; white-space:nowrap;">
              ✅ Confirmed
            </span>
          <% } else if (b.status === "Cancelled") { %>
            <span style="color:#b91c1c; font-weight:700; background:#fef2f2; padding:4px 8px; border-radius:12px; font-size:0.85rem; display:inline-block; white-space:nowrap;">
              ❌ Cancelled
            </span>
          <% } else { %>
            <span style="font-weight:700;"><%= b.status %></span>
          <% } %>
        </td>
        <td>
          <% if (b.status === "Accepted" && b.driverName) { %>
            <div style="font-size: 0.88rem; line-height: 1.4;">
              <strong style="color: #1e293b;"><%= b.driverName %></strong><br/>
              <span style="color: #475569;">&#128222; <a href="tel:<%= b.driverPhone %>" style="color: #0284c7; text-decoration: none; font-weight: 600;"><%= b.driverPhone %></a></span><br/>
              <span style="color: #64748b;">&#128656; <%= b.vanModel %> (<%= b.vanNumber %>)</span><br/>
              <span style="color: #94a3b8; font-size: 0.8rem;">Seats: <%= b.seatingCapacity %></span>
            </div>
          <% } else if (b.status === "Requested") { %>
            <span style="color: #64748b; font-style: italic;">Not assigned yet</span>
          <% } else if (b.status === "Cancelled") { %>
            <% if (b.driverName) { %>
              <div style="font-size: 0.82rem; color: #94a3b8;">
                <span style="text-decoration: line-through;"><%= b.driverName %></span>
                <div>(Trip Cancelled)</div>
              </div>
            <% } else { %>
              <span style="color: #94a3b8; font-style: italic;">None</span>
            <% } %>
          <% } else { %>
            <span style="color: #64748b; font-style: italic;">Package Booking</span>
          <% } %>
        </td>
        <td><%= b.bookedAt %></td>
        <td>
          <% if (b.status !== "Cancelled") { %>
            <form action="/cancel-booking/<%= b.id %>" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button
                type="submit"
                onclick="return confirm('Cancel this trip request?');"
                style="background:#dc3545; padding: 6px 12px; font-size: 0.85rem; margin-bottom: 0;">
                Cancel Request
              </button>
            </form>
          <% } else { %>
            <button disabled style="background:gray; padding: 6px 12px; font-size: 0.85rem; margin-bottom: 0;">
              Cancelled
            </button>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>

  <% } %>
</body>
</html>
