<%- include('partials/head', { title: 'My Trips Dashboard' }) %>
<%- include('partials/navbar', { activePage: 'dashboard' }) %>

<main style="padding: 2.5rem 0 4rem;">
  <div class="container">
    <%- include('partials/flash') %>

    <!-- TOP WELCOME BAR -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
      <div>
        <h1 style="font-size: 1.85rem; color: var(--primary-900); margin: 0;">
          Welcome back, <%= user.name || user.email.split('@')[0] %>
        </h1>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px; margin-bottom: 0;">
          Track your travel requests, view assigned driver details, and manage your journeys.
        </p>
      </div>
      <div>
        <a href="/#booking" class="btn btn-primary">+ Request a New Trip</a>
      </div>
    </div>

    <% 
      const totalTrips = bookings.length;
      const requestedTrips = bookings.filter(b => b.status === "Requested").length;
      const acceptedTrips = bookings.filter(b => b.status === "Accepted").length;
      const inProgressTrips = bookings.filter(b => b.status === "In Progress").length;
      const completedTrips = bookings.filter(b => b.status === "Completed").length;
      const cancelledTrips = bookings.filter(b => b.status === "Cancelled").length;
      const activeTrip = bookings.find(b => b.status === "In Progress" || b.status === "Accepted" || b.status === "Requested");
    %>

    <!-- SUMMARY METRIC CARDS -->
    <div class="stats-grid">
      <div class="stat-card">
        <div>
          <div class="stat-label">Total Requests</div>
          <div class="stat-value"><%= totalTrips %></div>
        </div>
        <div class="stat-icon">🧳</div>
      </div>

      <div class="stat-card">
        <div>
          <div class="stat-label">Looking for Driver</div>
          <div class="stat-value" style="color: var(--primary-600);"><%= requestedTrips %></div>
        </div>
        <div class="stat-icon">⏳</div>
      </div>

      <div class="stat-card">
        <div>
          <div class="stat-label">Active / Assigned</div>
          <div class="stat-value" style="color: var(--teal-600);"><%= acceptedTrips + inProgressTrips %></div>
        </div>
        <div class="stat-icon">🚐</div>
      </div>

      <div class="stat-card">
        <div>
          <div class="stat-label">Completed</div>
          <div class="stat-value" style="color: #15803d;"><%= completedTrips %></div>
        </div>
        <div class="stat-icon">✅</div>
      </div>

      <div class="stat-card">
        <div>
          <div class="stat-label">Cancelled</div>
          <div class="stat-value" style="color: var(--text-muted);"><%= cancelledTrips %></div>
        </div>
        <div class="stat-icon">✖️</div>
      </div>
    </div>

    <!-- FEATURED ACTIVE TRIP / CURRENT REQUEST -->
    <% if (activeTrip) { %>
      <div class="active-trip-hero" style="margin-top: 2rem;">
        <div class="active-trip-header">
          <div>
            <div style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--teal-500); font-weight: 700; margin-bottom: 4px;">
              Active Travel Journey
            </div>
            <h2>🌴 <%= activeTrip.destination %></h2>
          </div>
          <div>
            <% if (activeTrip.status === "Requested") { %>
              <span class="badge" style="background: rgba(254, 243, 199, 0.95); color: #92400e; font-size: 0.9rem; padding: 6px 14px;">
                🟡 Looking for Driver
              </span>
            <% } else if (activeTrip.status === "Accepted") { %>
              <span class="badge" style="background: #dcfce7; color: #15803d; font-size: 0.9rem; padding: 6px 14px;">
                🟢 Driver Assigned
              </span>
            <% } else if (activeTrip.status === "In Progress") { %>
              <span class="badge" style="background: #dbeafe; color: #1e40af; font-size: 0.9rem; padding: 6px 14px; animation: pulse 2s infinite;">
                🚀 Trip In Progress (En Route)
              </span>
            <% } %>
          </div>
        </div>

        <!-- TRIP PROGRESS TIMELINE STEPPER -->
        <div style="background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--radius-md); padding: 1.25rem 1.5rem; margin: 1.5rem 0;">
          <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; font-weight: 700; margin-bottom: 1rem;">
            Journey Progress
          </div>

          <%
            let currentStep = 1;
            if (activeTrip.status === "Requested") currentStep = 1;
            else if (activeTrip.status === "Accepted") currentStep = 2;
            else if (activeTrip.status === "In Progress") currentStep = 3;
            else if (activeTrip.status === "Completed") currentStep = 4;
          %>

          <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; position: relative;">
            <!-- STEP 1 -->
            <div style="text-align: center;">
              <div style="width: 32px; height: 32px; border-radius: 50%; margin: 0 auto 6px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; <%= currentStep >= 1 ? 'background: #10b981; color: white;' : 'background: #334155; color: #94a3b8;' %>">
                <%= currentStep > 1 ? '✓' : '1' %>
              </div>
              <div style="font-size: 0.82rem; font-weight: 600; color: <%= currentStep >= 1 ? '#f8fafc' : '#94a3b8' %>;">
                Requested
              </div>
              <div style="font-size: 0.72rem; color: #94a3b8;"><%= activeTrip.bookedAt || 'Booked' %></div>
            </div>

            <!-- STEP 2 -->
            <div style="text-align: center;">
              <div style="width: 32px; height: 32px; border-radius: 50%; margin: 0 auto 6px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; <%= currentStep >= 2 ? 'background: #10b981; color: white;' : 'background: #334155; color: #94a3b8;' %>">
                <%= currentStep > 2 ? '✓' : '2' %>
              </div>
              <div style="font-size: 0.82rem; font-weight: 600; color: <%= currentStep >= 2 ? '#f8fafc' : '#94a3b8' %>;">
                Driver Accepted
              </div>
              <div style="font-size: 0.72rem; color: #94a3b8;"><%= activeTrip.acceptedAt || (currentStep >= 2 ? 'Confirmed' : 'Pending') %></div>
            </div>

            <!-- STEP 3 -->
            <div style="text-align: center;">
              <div style="width: 32px; height: 32px; border-radius: 50%; margin: 0 auto 6px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; <%= currentStep >= 3 ? 'background: #3b82f6; color: white;' : 'background: #334155; color: #94a3b8;' %>">
                <%= currentStep > 3 ? '✓' : '3' %>
              </div>
              <div style="font-size: 0.82rem; font-weight: 600; color: <%= currentStep >= 3 ? '#f8fafc' : '#94a3b8' %>;">
                In Progress
              </div>
              <div style="font-size: 0.72rem; color: #94a3b8;"><%= activeTrip.startedAt || (currentStep >= 3 ? 'En Route' : 'Upcoming') %></div>
            </div>

            <!-- STEP 4 -->
            <div style="text-align: center;">
              <div style="width: 32px; height: 32px; border-radius: 50%; margin: 0 auto 6px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; <%= currentStep >= 4 ? 'background: #10b981; color: white;' : 'background: #334155; color: #94a3b8;' %>">
                <%= currentStep >= 4 ? '✓' : '4' %>
              </div>
              <div style="font-size: 0.82rem; font-weight: 600; color: <%= currentStep >= 4 ? '#f8fafc' : '#94a3b8' %>;">
                Completed
              </div>
              <div style="font-size: 0.72rem; color: #94a3b8;"><%= activeTrip.completedAt || 'Final Destination' %></div>
            </div>
          </div>
        </div>

        <div class="active-trip-grid">
          <!-- TRIP ITINERARY DETAILS -->
          <div class="trip-meta-box">
            <div class="trip-meta-row">
              <span style="font-size: 1.2rem;">📅</span>
              <span><strong>Dates:</strong> <%= activeTrip.fromDate %> &rarr; <%= activeTrip.toDate %></span>
            </div>
            <div class="trip-meta-row">
              <span style="font-size: 1.2rem;">👥</span>
              <span><strong>Travelers:</strong> <%= activeTrip.people %> Passenger<%= activeTrip.people === 1 ? '' : 's' %></span>
            </div>
            <div class="trip-meta-row">
              <span style="font-size: 1.2rem;">👤</span>
              <span><strong>Lead Traveler:</strong> <%= activeTrip.name %> (<%= activeTrip.countryCode %> <%= activeTrip.phone %>)</span>
            </div>
            <div class="trip-meta-row">
              <span style="font-size: 1.2rem;">🕒</span>
              <span style="font-size: 0.88rem; color: #cbd5e1;"><strong>Submitted:</strong> <%= activeTrip.bookedAt %></span>
            </div>

            <div style="margin-top: 1.25rem;">
              <% if (activeTrip.status === "Requested" || activeTrip.status === "Accepted") { %>
                <form action="/cancel-booking/<%= activeTrip.id %>" method="POST" onsubmit="return confirm('Are you sure you want to cancel this trip booking?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-outline btn-sm" style="color: #fecaca; border-color: rgba(254, 202, 202, 0.3);">
                    Cancel Request
                  </button>
                </form>
              <% } else if (activeTrip.status === "In Progress") { %>
                <div style="font-size: 0.85rem; color: #93c5fd; background: rgba(30, 58, 138, 0.4); padding: 8px 12px; border-radius: var(--radius-sm); border: 1px solid rgba(59, 130, 246, 0.3);">
                  ℹ️ This trip is currently en route. Safe travels!
                </div>
              <% } %>
            </div>
          </div>

          <!-- ASSIGNED DRIVER DETAILS / PENDING MATCHING STATE -->
          <% if ((activeTrip.status === "Accepted" || activeTrip.status === "In Progress") && activeTrip.driverName) { %>
            <% 
              const waClean = ((activeTrip.driverPhone || '').replace(/[^0-9]/g, ''));
            %>
            <div class="driver-assigned-box">
              <div class="driver-assigned-title">
                ✓ Assigned Van Driver
              </div>
              <div class="driver-name-lg">
                <%= activeTrip.driverName %>
              </div>
              <div class="driver-vehicle-info">
                <div>🚐 <strong><%= activeTrip.vanModel %></strong></div>
                <div>Plate: <strong style="color: #fff;"><%= activeTrip.vanNumber %></strong> (<%= activeTrip.seatingCapacity %> Seats)</div>
                <div style="margin-top: 4px; font-size: 0.85rem; color: #94a3b8;">Registered Van Driver</div>
              </div>

              <div class="driver-contact-actions">
                <a href="tel:<%= activeTrip.driverPhone %>" class="btn btn-secondary btn-sm" style="flex: 1;">
                  📞 Call Driver
                </a>
                <% if (waClean) { %>
                  <a href="https://wa.me/<%= waClean %>?text=Hello%20<%= encodeURIComponent(activeTrip.driverName) %>,%20I%20am%20the%20traveler%20for%20the%20Destination%20Paradise%20trip%20to%20<%= encodeURIComponent(activeTrip.destination) %>." target="_blank" class="btn btn-primary btn-sm" style="background-color: #25d366; border-color: #25d366; flex: 1;">
                    💬 WhatsApp
                  </a>
                <% } %>
              </div>
            </div>
          <% } else { %>
            <div class="driver-assigned-box" style="border-style: dashed;">
              <div class="driver-assigned-title" style="color: #fef08a;">
                ⏳ Driver Search In Progress
              </div>
              <p style="color: #e2e8f0; font-size: 0.92rem; line-height: 1.5; margin: 0.5rem 0 1rem;">
                Your trip is visible in our driver marketplace. Available van drivers with matching capacity will contact you directly via phone or WhatsApp to coordinate your journey.
              </p>
              <div style="font-size: 0.82rem; color: #94a3b8;">
                • Registered local drivers<br/>
                • Verified capacity matching
              </div>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- COMPLETE TRIP HISTORY -->
    <div style="margin-top: 2.5rem;">
      <h2 style="font-size: 1.35rem; color: var(--primary-900); margin-bottom: 1.25rem;">
        Trip History & Requests (<%= totalTrips %>)
      </h2>

      <% if (bookings.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">🏖️</div>
          <h3 class="empty-title">No trip requests yet</h3>
          <p class="empty-desc">You haven't requested any vacation trips yet. Plan your dream trip and connect with experienced local van drivers.</p>
          <a href="/#booking" class="btn btn-primary">Plan Your First Trip &rarr;</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Destination</th>
                <th>Dates</th>
                <th>Travelers</th>
                <th>Status</th>
                <th>Assigned Driver & Vehicle</th>
                <th>Submitted</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% bookings.forEach((b) => { %>
                <tr>
                  <td style="font-weight: 700; color: var(--primary-900);"><%= b.destination %></td>
                  <td style="white-space: nowrap;"><%= b.fromDate %> &rarr; <%= b.toDate %></td>
                  <td><%= b.people %> Person<%= b.people === 1 ? '' : 's' %></td>
                  <td>
                    <% if (b.status === "Requested") { %>
                      <span style="color:#92400e; font-weight:700; background:#fef3c7; padding:4px 8px; border-radius:12px; font-size:0.85rem; display:inline-block; white-space:nowrap;">
                        🟡 Looking for Driver
                      </span>
                    <% } else if (b.status === "Accepted") { %>
                      <span style="color:#166534; font-weight:700; background:#dcfce7; padding:4px 8px; border-radius:12px; font-size:0.85rem; display:inline-block; white-space:nowrap;">
                        🟢 Driver Assigned
                      </span>
                    <% } else if (b.status === "In Progress") { %>
                      <span style="color:#1e40af; font-weight:700; background:#dbeafe; padding:4px 8px; border-radius:12px; font-size:0.85rem; display:inline-block; white-space:nowrap;">
                        🚀 In Progress
                      </span>
                    <% } else if (b.status === "Completed") { %>
                      <span style="color:#15803d; font-weight:700; background:#f0fdf4; padding:4px 8px; border-radius:12px; font-size:0.85rem; display:inline-block; white-space:nowrap;">
                        ✅ Completed
                      </span>
                    <% } else if (b.status === "Confirmed") { %>
                      <span style="color:#15803d; font-weight:700; background:#f0fdf4; padding:4px 8px; border-radius:12px; font-size:0.85rem; display:inline-block; white-space:nowrap;">
                        ✅ Confirmed
                      </span>
                    <% } else if (b.status === "Cancelled") { %>
                      <span style="color:#b91c1c; font-weight:700; background:#fef2f2; padding:4px 8px; border-radius:12px; font-size:0.85rem; display:inline-block; white-space:nowrap;">
                        ❌ Cancelled
                      </span>
                    <% } else { %>
                      <span style="font-weight:700;"><%= b.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <% if ((b.status === "Accepted" || b.status === "In Progress" || b.status === "Completed") && b.driverName) { %>
                      <div style="font-size: 0.88rem; line-height: 1.4;">
                        <strong style="color: var(--primary-900);"><%= b.driverName %></strong><br/>
                        <span style="color: var(--text-muted);">📞 <a href="tel:<%= b.driverPhone %>" style="color: var(--primary-600); font-weight: 600;"><%= b.driverPhone %></a></span><br/>
                        <span style="color: var(--text-muted);">🚐 <%= b.vanModel %> (<%= b.vanNumber %>)</span>
                      </div>
                    <% } else if (b.status === "Requested") { %>
                      <span style="color: var(--text-muted); font-style: italic;">Matching in progress</span>
                    <% } else if (b.status === "Cancelled") { %>
                      <% if (b.driverName) { %>
                        <div style="font-size: 0.82rem; color: var(--text-muted);">
                          <span style="text-decoration: line-through;"><%= b.driverName %></span>
                          <div>Cancelled by <%= b.cancelledBy || 'system' %></div>
                          <% if (b.cancellationReason) { %>
                            <div style="font-style: italic; font-size: 0.78rem;">"<%= b.cancellationReason %>"</div>
                          <% } %>
                        </div>
                      <% } else { %>
                        <span style="color: var(--text-muted); font-style: italic;">Cancelled by <%= b.cancelledBy || 'tourist' %></span>
                      <% } %>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-style: italic;">Package Booking</span>
                    <% } %>
                  </td>
                  <td style="font-size: 0.85rem; color: var(--text-muted); white-space: nowrap;"><%= b.bookedAt %></td>
                  <td>
                    <% if (b.status === "Requested" || b.status === "Accepted") { %>
                      <form action="/cancel-booking/<%= b.id %>" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button
                          type="submit"
                          onclick="return confirm('Are you sure you want to cancel this booking?');"
                          class="btn btn-outline btn-sm"
                          style="color: #dc2626; border-color: #fca5a5;">
                          Cancel
                        </button>
                      </form>
                    <% } else if (b.status === "In Progress") { %>
                      <span style="font-size: 0.82rem; color: #1e40af; font-weight: 600;">Active En Route</span>
                    <% } else if (b.status === "Completed") { %>
                      <span style="font-size: 0.82rem; color: #15803d; font-weight: 600;">✓ Finished</span>
                    <% } else { %>
                      <span style="font-size: 0.85rem; color: var(--text-muted); font-style: italic;">Closed</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
