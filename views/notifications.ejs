<%- include('partials/head', { title: 'Notifications' }) %>
<%- include('partials/navbar', { activePage: 'notifications' }) %>

<main style="padding: 2.5rem 0 4rem;">
  <div class="container" style="max-width: 860px;">
    <%- include('partials/flash') %>

    <!-- PAGE HEADER -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
      <div>
        <h1 style="font-size: 1.85rem; color: var(--primary-900); margin: 0;">
          Notifications
        </h1>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px; margin-bottom: 0;">
          Real-time updates regarding your trip requests, assignments, and account status.
        </p>
      </div>

      <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
        <form action="/notifications/mark-all-read" method="POST">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="btn btn-outline btn-sm">
            ✓ Mark All as Read (<%= unreadCount %>)
          </button>
        </form>
      <% } %>
    </div>

    <!-- NOTIFICATION LIST -->
    <% if (typeof notifications === 'undefined' || !Array.isArray(notifications) || notifications.length === 0) { %>
      <div class="card" style="text-align: center; padding: 4rem 2rem;">
        <div style="font-size: 3rem; margin-bottom: 1rem;">🔔</div>
        <h3 style="font-size: 1.35rem; color: var(--primary-900); margin-bottom: 0.5rem;">No Notifications Yet</h3>
        <p style="color: var(--text-muted); font-size: 0.95rem; max-width: 420px; margin: 0 auto;">
          You don't have any notifications right now. Activity on your trip requests and account will appear here.
        </p>
      </div>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% notifications.forEach((notif) => { %>
          <%
            let icon = '🔔';
            let iconBg = 'rgba(14, 165, 233, 0.1)';
            if (notif.type === 'TRIP_ACCEPTED') {
              icon = '🚐';
              iconBg = 'rgba(16, 185, 129, 0.12)';
            } else if (notif.type === 'TRIP_STARTED') {
              icon = '🚀';
              iconBg = 'rgba(59, 130, 246, 0.12)';
            } else if (notif.type === 'TRIP_COMPLETED') {
              icon = '🏁';
              iconBg = 'rgba(16, 185, 129, 0.12)';
            } else if (notif.type === 'TRIP_CANCELLED') {
              icon = '⚠️';
              iconBg = 'rgba(239, 68, 68, 0.12)';
            } else if (notif.type === 'DRIVER_VERIFIED') {
              icon = '🛡️';
              iconBg = 'rgba(16, 185, 129, 0.12)';
            } else if (notif.type === 'DRIVER_REJECTED') {
              icon = '✕';
              iconBg = 'rgba(239, 68, 68, 0.12)';
            }
          %>
          <div class="card" style="padding: 1.25rem 1.5rem; display: flex; gap: 1rem; align-items: flex-start; transition: box-shadow 0.2s; <%= !notif.isRead ? 'border-left: 4px solid var(--teal-600); background: #f8fafc;' : 'opacity: 0.85;' %>">
            <div style="font-size: 1.6rem; width: 44px; height: 44px; border-radius: 50%; background: <%= iconBg %>; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <%= icon %>
            </div>

            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap; margin-bottom: 4px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <h4 style="font-size: 1.05rem; font-weight: 700; color: var(--primary-900); margin: 0;">
                    <%= notif.title %>
                  </h4>
                  <% if (!notif.isRead) { %>
                    <span class="badge" style="background: #e0f2fe; color: #0369a1; font-size: 0.72rem; padding: 2px 8px;">
                      New
                    </span>
                  <% } %>
                </div>
                <span style="font-size: 0.8rem; color: var(--text-muted);">
                  <%= notif.createdAtFormatted %>
                </span>
              </div>

              <p style="color: var(--text-primary); font-size: 0.92rem; line-height: 1.5; margin: 0 0 10px 0;">
                <%= notif.message %>
              </p>

              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                <div>
                  <% if (notif.link) { %>
                    <a href="<%= notif.link %>" class="btn btn-sm btn-outline" style="padding: 4px 12px; font-size: 0.82rem;">
                      View Details &rarr;
                    </a>
                  <% } %>
                </div>

                <% if (!notif.isRead) { %>
                  <form action="/notifications/<%= notif.id %>/read" method="POST" style="margin: 0;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm" style="background: transparent; color: var(--text-muted); font-size: 0.8rem; padding: 4px 8px; border: none; cursor: pointer; text-decoration: underline;">
                      Mark as read
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>

