<%- include('partials/head', { title: 'My Accepted Trips' }) %>
<%- include('partials/navbar', { activePage: 'my-trips' }) %>

<main style="padding: 2.5rem 0 4rem;">
  <div class="container">
    <%- include('partials/flash') %>

    <!-- PAGE HEADER -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
      <div>
        <h1 style="font-size: 1.85rem; color: var(--primary-900);">
          My Accepted Trips
        </h1>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">
          Track your active tourist assignments, coordinate with travelers, and review past completed journeys.
        </p>
      </div>

      <a href="/driver/trips" class="btn btn-primary btn-sm">
        + Browse Trip Requests
      </a>
    </div>

    <!-- UPCOMING TRIPS SECTION -->
    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 1.25rem;">
      <h2 style="font-size: 1.35rem; color: var(--primary-900); margin: 0;">
        🗓️ Upcoming & Active Trips
      </h2>
      <span class="badge badge-active">
        <%= upcomingTrips.length %> Active
      </span>
    </div>

    <% if (upcomingTrips.length === 0) { %>
      <div class="empty-state" style="margin-bottom: 3rem;">
        <div class="empty-state-icon">🏖️</div>
        <h3 class="empty-state-title">No Upcoming Trips Scheduled</h3>
        <p class="empty-state-desc">
          You have not accepted any upcoming tourist trips yet. Explore the marketplace to find travel requests matching your schedule.
        </p>
        <a href="/driver/trips" class="btn btn-secondary">
          Browse Open Trip Requests &rarr;
        </a>
      </div>
    <% } else { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
        <% upcomingTrips.forEach((trip) => { %>
          <% 
            const cleanPhone = (trip.countryCode || '') + (trip.phone || '');
            const waDigits = cleanPhone.replace(/[^0-9]/g, '');
            const acceptedDateStr = trip.acceptedAt ? (typeof trip.acceptedAt.toDate === 'function' ? trip.acceptedAt.toDate().toLocaleDateString() : new Date(trip.acceptedAt).toLocaleDateString()) : 'Recently';
          %>
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; border-top: 4px solid var(--teal-600);">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 1rem;">
                <h3 style="font-size: 1.25rem; color: var(--primary-900); margin: 0;">
                  🌴 <%= trip.destination %>
                </h3>
                <span class="badge badge-active">🟢 Accepted & Confirmed</span>
              </div>

              <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 1.25rem;">
                <div style="font-size: 0.95rem; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
                  <span>📅</span> <%= trip.fromDate %> &rarr; <%= trip.toDate %>
                </div>
                <div style="font-size: 0.9rem; color: var(--text-muted); display: flex; align-items: center; gap: 8px;">
                  <span>👥</span> <strong><%= trip.people %></strong> Passenger<%= trip.people === 1 ? '' : 's' %>
                </div>
              </div>

              <!-- TOURIST CONTACT CARD -->
              <div style="background: var(--bg-alt); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; border-left: 3px solid var(--teal-600);">
                <div style="font-size: 0.72rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">
                  Tourist Details
                </div>
                <div style="font-size: 1rem; font-weight: 700; color: var(--primary-900); margin-bottom: 4px;">
                  <%= trip.name %>
                </div>
                <div style="font-size: 0.9rem; color: var(--text-secondary); display: flex; align-items: center; gap: 6px;">
                  <span>📞</span> <%= trip.countryCode %> <%= trip.phone %>
                </div>
              </div>

              <div style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 1.25rem;">
                Accepted on: <%= acceptedDateStr %>
              </div>
            </div>

            <!-- DIRECT CONTACT ACTIONS -->
            <div style="display: flex; gap: 10px;">
              <a href="tel:<%= trip.countryCode %><%= trip.phone %>" class="btn btn-outline btn-sm" style="flex: 1; text-align: center;">
                📞 Call Tourist
              </a>
              <% if (waDigits) { %>
                <a href="https://wa.me/<%= waDigits %>?text=Hello%20<%= encodeURIComponent(trip.name) %>,%20I%20am%20your%20assigned%20van%20driver%20on%20Destination%20Paradise%20for%20your%20trip%20to%20<%= encodeURIComponent(trip.destination) %>." target="_blank" class="btn btn-teal btn-sm" style="flex: 1; text-align: center;">
                  💬 WhatsApp
                </a>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- PAST TRIPS SECTION -->
    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 1.25rem;">
      <h2 style="font-size: 1.35rem; color: var(--primary-900); margin: 0;">
        📁 Concluded & Past Trips
      </h2>
      <span class="badge badge-inactive">
        <%= pastTrips.length %> Past
      </span>
    </div>

    <% if (pastTrips.length === 0) { %>
      <div class="card" style="padding: 2rem; text-align: center; color: var(--text-muted);">
        <p style="margin: 0;">No completed or historical trips recorded yet.</p>
      </div>
    <% } else { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
        <% pastTrips.forEach((trip) => { %>
          <% 
            const cleanPhone = (trip.countryCode || '') + (trip.phone || '');
            const waDigits = cleanPhone.replace(/[^0-9]/g, '');
            const acceptedDateStr = trip.acceptedAt ? (typeof trip.acceptedAt.toDate === 'function' ? trip.acceptedAt.toDate().toLocaleDateString() : new Date(trip.acceptedAt).toLocaleDateString()) : 'N/A';
          %>
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; opacity: 0.9; background: #fafbfc;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 1rem;">
                <h3 style="font-size: 1.25rem; color: var(--primary-900); margin: 0;">
                  🌴 <%= trip.destination %>
                </h3>
                <span class="badge badge-inactive">Concluded</span>
              </div>

              <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 1.25rem;">
                <div style="font-size: 0.95rem; color: var(--text-secondary); display: flex; align-items: center; gap: 8px;">
                  <span>📅</span> <%= trip.fromDate %> &rarr; <%= trip.toDate %>
                </div>
                <div style="font-size: 0.9rem; color: var(--text-muted); display: flex; align-items: center; gap: 8px;">
                  <span>👥</span> <%= trip.people %> Passenger<%= trip.people === 1 ? '' : 's' %>
                </div>
              </div>

              <!-- TOURIST DETAILS -->
              <div style="background: var(--bg-surface); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; border-left: 3px solid var(--border-subtle);">
                <div style="font-size: 0.72rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 2px;">
                  Tourist Details
                </div>
                <div style="font-size: 1rem; font-weight: 700; color: var(--primary-900); margin-bottom: 4px;">
                  <%= trip.name %>
                </div>
                <div style="font-size: 0.9rem; color: var(--text-secondary);">
                  <span>📞</span> <%= trip.countryCode %> <%= trip.phone %>
                </div>
              </div>

              <div style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 1.25rem;">
                Accepted on: <%= acceptedDateStr %>
              </div>
            </div>

            <!-- CONTACT ACTIONS -->
            <div style="display: flex; gap: 10px;">
              <a href="tel:<%= trip.countryCode %><%= trip.phone %>" class="btn btn-outline btn-sm" style="flex: 1; text-align: center;">
                📞 Call
              </a>
              <% if (waDigits) { %>
                <a href="https://wa.me/<%= waDigits %>" target="_blank" class="btn btn-outline btn-sm" style="flex: 1; text-align: center;">
                  💬 WhatsApp
                </a>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
