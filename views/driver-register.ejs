<%- include('partials/head', { title: 'Driver Registration' }) %>
<%- include('partials/navbar', { activePage: 'driver-register' }) %>

<main style="padding: 3.5rem 0; min-height: 80vh;">
  <div class="container container-narrow">
    <div class="card" style="max-width: 600px; margin: 0 auto; padding: 2.5rem; box-shadow: var(--shadow-md); border-top: 4px solid var(--primary-800);">
      <div style="text-align: center; margin-bottom: 2rem;">
        <div class="brand-icon" style="margin: 0 auto 0.75rem; width: 48px; height: 48px; font-size: 1.5rem; background: var(--primary-800);">
          🚐
        </div>
        <span class="brand-badge" style="font-size: 0.75rem; padding: 3px 8px; margin-bottom: 0.5rem; display: inline-block;">
          VAN DRIVER PORTAL
        </span>
        <h1 style="font-size: 1.6rem; color: var(--primary-900); margin-top: 4px;">Driver Onboarding</h1>
        <p style="font-size: 0.92rem; color: var(--text-muted); margin-top: 4px;">
          Join Destination Paradise to discover matching tourist trip requests in your region.
        </p>
      </div>

      <%- include('partials/flash') %>

      <form action="/driver/register" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-section-title">
          <span>👤</span> Personal & Account Information
        </div>

        <div class="form-group">
          <label for="name">Full Name *</label>
          <input type="text" id="name" name="name" class="form-control" placeholder="e.g. Ramesh Kumar" required />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="email">Driver Email Address *</label>
            <input type="email" id="email" name="email" class="form-control" placeholder="driver@example.com" required autocomplete="email" />
          </div>

          <div class="form-group">
            <label for="phone">Phone / WhatsApp Number *</label>
            <input type="tel" id="phone" name="phone" class="form-control" placeholder="+91 9876543210" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="password">Account Password *</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="Min 6 characters" required minlength="6" autocomplete="new-password" />
          </div>

          <div class="form-group">
            <label for="licenseNumber">Driver License Number *</label>
            <input type="text" id="licenseNumber" name="licenseNumber" class="form-control" placeholder="e.g. DL-04-20150012345" required />
          </div>
        </div>

        <div class="form-section-title">
          <span>🚐</span> Vehicle Specifications
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="vanModel">Van Make & Model *</label>
            <input type="text" id="vanModel" name="vanModel" class="form-control" placeholder="e.g. Force Traveller, Toyota HiAce" required />
          </div>

          <div class="form-group">
            <label for="vanNumber">Vehicle Registration Plate *</label>
            <input type="text" id="vanNumber" name="vanNumber" class="form-control" placeholder="e.g. TS 09 AB 1234" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="seatingCapacity">Passenger Seating Capacity *</label>
            <input type="number" id="seatingCapacity" name="seatingCapacity" class="form-control" min="4" max="20" placeholder="e.g. 12" required />
            <div class="form-hint">Passenger seats excluding driver (4 to 20 seats).</div>
          </div>

          <div class="form-group">
            <label for="experienceYears">Driving Experience (Years) *</label>
            <input type="number" id="experienceYears" name="experienceYears" class="form-control" min="0" max="60" placeholder="e.g. 7" required />
          </div>
        </div>

        <div style="margin-top: 1.75rem;">
          <button type="submit" class="btn btn-secondary btn-block btn-lg">
            Complete Driver Registration
          </button>
        </div>
      </form>

      <div style="margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); text-align: center;">
        <p style="font-size: 0.9rem; color: var(--text-muted);">
          Already registered as a driver? 
          <a href="/driver/login" style="font-weight: 700; color: var(--teal-600);">Sign in here</a>
        </p>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
