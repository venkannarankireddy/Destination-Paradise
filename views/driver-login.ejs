<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Driver Login | Destination Paradise</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: url('/images/home4.jpg') no-repeat center center fixed;
      background-size: cover;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
    }
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      z-index: 0;
    }
    .login-container {
      position: relative;
      z-index: 1;
      background: rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      padding: 2.5rem;
      border-radius: 16px;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
      width: 340px;
      color: #fff;
      text-align: center;
    }
    .badge {
      display: inline-block;
      background: #ff5722;
      color: white;
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: bold;
      margin-bottom: 0.75rem;
    }
    h2 {
      margin-bottom: 0.5rem;
      color: #ffffff;
      font-weight: 700;
    }
    .subtext {
      font-size: 0.88rem;
      color: #ffebf0;
      margin-bottom: 1.5rem;
    }
    input {
      width: 100%;
      padding: 0.7rem 0.8rem;
      margin-bottom: 1.2rem;
      border: none;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.9);
      color: #333;
      font-size: 14px;
      box-sizing: border-box;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }
    input:focus {
      outline: 2px solid #e91e63;
      background: #fff;
    }
    button {
      width: 100%;
      padding: 0.75rem;
      background: #e91e63;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
      font-size: 1rem;
      transition: background 0.3s ease;
      box-shadow: 0 4px 12px rgba(233, 30, 99, 0.4);
    }
    button:hover {
      background: #d81b60;
    }
    p {
      margin-top: 1.2rem;
      color: #ffffff;
      font-size: 0.9rem;
    }
    a {
      color: #ffeef5;
      font-weight: bold;
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="overlay"></div>
  <div class="login-container">
    <span class="badge">VAN DRIVER PORTAL</span>
    <h2>Driver Login</h2>
    <p class="subtext">Sign in to manage your van and view trip requests.</p>
    
    <form action="/driver/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="email" id="email" name="email" placeholder="Driver Email" required />
      <input type="password" id="password" name="password" placeholder="Password" required />
      <button type="submit">Sign In as Driver</button>
    </form>

    <p>New van driver? <a href="/driver/register">Register as Driver</a></p>
    <p style="font-size: 0.85rem; margin-top: 0.5rem;">Are you a tourist? <a href="/login">Tourist Login</a></p>
  </div>
</body>
</html>

