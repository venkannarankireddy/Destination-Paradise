<%- include('partials/head', { title: 'Driver Portal Login' }) %>
<%- include('partials/navbar', { activePage: 'driver-login' }) %>

<main style="padding: 3.5rem 0; min-height: 75vh; display: flex; align-items: center;">
  <div class="container container-narrow">
    <div class="card" style="max-width: 440px; margin: 0 auto; padding: 2.5rem; box-shadow: var(--shadow-md); border-top: 4px solid var(--primary-800);">
      <div style="text-align: center; margin-bottom: 2rem;">
        <div class="brand-icon" style="margin: 0 auto 0.75rem; width: 48px; height: 48px; font-size: 1.5rem; background: var(--primary-800);">
          🚐
        </div>
        <span class="brand-badge" style="font-size: 0.75rem; padding: 3px 8px; margin-bottom: 0.5rem; display: inline-block;">
          VAN DRIVER PORTAL
        </span>
        <h1 style="font-size: 1.6rem; color: var(--primary-900); margin-top: 4px;">Driver Sign In</h1>
        <p style="font-size: 0.92rem; color: var(--text-muted); margin-top: 4px;">
          Access your marketplace, schedule availability, and manage accepted trips.
        </p>
      </div>

      <%- include('partials/flash') %>

      <form action="/driver/login" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="email">Registered Driver Email</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="driver@example.com" required autocomplete="email" />
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required autocomplete="current-password" />
        </div>

        <div style="margin-top: 1.5rem;">
          <button type="submit" class="btn btn-secondary btn-block btn-lg">
            Sign In as Van Driver
          </button>
        </div>
      </form>

      <div style="margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); text-align: center;">
        <p style="font-size: 0.9rem; color: var(--text-muted);">
          New van driver? 
          <a href="/driver/register" style="font-weight: 700; color: var(--teal-600);">Register as Driver</a>
        </p>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin-top: 0.75rem;">
          Are you a traveler? 
          <a href="/login" style="font-weight: 700; color: var(--primary-600);">Tourist Login &rarr;</a>
        </p>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
