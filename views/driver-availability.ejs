<%- include('partials/head', { title: 'Driver Availability' }) %>
<%- include('partials/navbar', { activePage: 'availability' }) %>

<main style="padding: 2.5rem 0 4rem;">
  <div class="container" style="max-width: 1000px;">
    <%- include('partials/flash') %>

    <!-- PAGE HEADER -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
      <div>
        <h1 style="font-size: 1.85rem; color: var(--primary-900);">
          Manage Availability Schedule
        </h1>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">
          Define specific date windows when you and your vehicle are available to accept tourist bookings.
        </p>
      </div>

      <a href="/driver/dashboard" class="btn btn-outline btn-sm">
        &larr; Back to Dashboard
      </a>
    </div>

    <!-- ADD AVAILABILITY FORM CARD -->
    <div class="card" style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 1.25rem; color: var(--primary-900); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 8px;">
        <span>📅</span> Add New Availability Window
      </h2>

      <form action="/driver/availability" method="POST" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) auto; gap: 1.25rem; align-items: flex-end;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group" style="margin: 0;">
          <label for="fromDate" class="form-label">From Date *</label>
          <input 
            type="date" 
            id="fromDate" 
            name="fromDate" 
            class="form-input" 
            min="<%= todayStr %>" 
            required 
          />
        </div>

        <div class="form-group" style="margin: 0;">
          <label for="toDate" class="form-label">To Date *</label>
          <input 
            type="date" 
            id="toDate" 
            name="toDate" 
            class="form-input" 
            min="<%= todayStr %>" 
            required 
          />
        </div>

        <div class="form-group" style="margin: 0;">
          <label for="status" class="form-label">Initial Status *</label>
          <select id="status" name="status" class="form-select" required>
            <option value="available" selected>Available</option>
            <option value="unavailable">Unavailable</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary" style="height: 44px; white-space: nowrap;">
          + Add Window
        </button>
      </form>
    </div>

    <!-- SCHEDULED PERIODS CARD -->
    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
        <h2 style="font-size: 1.25rem; color: var(--primary-900); margin: 0; display: flex; align-items: center; gap: 8px;">
          <span>📋</span> Scheduled Availability Windows
        </h2>
        <span class="badge badge-active" style="font-size: 0.8rem;">
          <%= availabilities.length %> Period<%= availabilities.length === 1 ? '' : 's' %> Defined
        </span>
      </div>

      <% if (availabilities.length === 0) { %>
        <div class="empty-state" style="padding: 2.5rem 1rem;">
          <div class="empty-state-icon">📆</div>
          <h3 class="empty-state-title">No Availability Windows Scheduled</h3>
          <p class="empty-state-desc">
            You haven't defined any working dates yet. Add your upcoming available dates above so tourist requests can match with your profile.
          </p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Status</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% availabilities.forEach((period) => { %>
                <tr>
                  <td style="font-weight: 600; color: var(--primary-900);">
                    📅 <%= period.fromDate %>
                  </td>
                  <td style="font-weight: 600; color: var(--primary-900);">
                    📅 <%= period.toDate %>
                  </td>
                  <td>
                    <% if (period.status === 'available') { %>
                      <span class="badge badge-active">● Available</span>
                    <% } else { %>
                      <span class="badge badge-inactive">● Unavailable</span>
                    <% } %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; gap: 8px; align-items: center; justify-content: flex-end;">
                      <!-- TOGGLE STATUS -->
                      <form action="/driver/availability/<%= period.availabilityId %>/toggle" method="POST" style="display:inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline btn-sm" title="Toggle between available and unavailable">
                          <%= period.status === 'available' ? 'Mark Unavailable' : 'Mark Available' %>
                        </button>
                      </form>

                      <!-- EDIT MODAL TRIGGER -->
                      <button 
                        type="button" 
                        class="btn btn-secondary btn-sm" 
                        onclick="openEditModal('<%= period.availabilityId %>', '<%= period.fromDate %>', '<%= period.toDate %>', '<%= period.status %>')"
                      >
                        ✏️ Edit
                      </button>

                      <!-- DELETE ACTION -->
                      <form action="/driver/availability/<%= period.availabilityId %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this availability window?');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline btn-sm" style="color: var(--danger); border-color: #fecaca;">
                          🗑️ Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<!-- EDIT MODAL -->
<div id="editModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1000; align-items: center; justify-content: center; padding: 1.5rem;">
  <div class="card" style="width: 100%; max-width: 480px; box-shadow: var(--shadow-xl); border: 1px solid var(--border-subtle); animation: modalFadeIn 0.2s ease-out;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--border-subtle);">
      <h3 style="font-size: 1.25rem; color: var(--primary-900); margin: 0;">Edit Availability Window</h3>
      <button type="button" onclick="closeEditModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-muted); line-height: 1;">&times;</button>
    </div>

    <form id="editForm" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="editFromDate" class="form-label">From Date *</label>
        <input type="date" id="editFromDate" name="fromDate" class="form-input" min="<%= todayStr %>" required />
      </div>

      <div class="form-group">
        <label for="editToDate" class="form-label">To Date *</label>
        <input type="date" id="editToDate" name="toDate" class="form-input" min="<%= todayStr %>" required />
      </div>

      <div class="form-group">
        <label for="editStatus" class="form-label">Status *</label>
        <select id="editStatus" name="status" class="form-select" required>
          <option value="available">Available</option>
          <option value="unavailable">Unavailable</option>
        </select>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.5rem;">
        <button type="button" class="btn btn-outline" onclick="closeEditModal()">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditModal(id, from, to, status) {
    const modal = document.getElementById('editModal');
    const form = document.getElementById('editForm');
    form.action = '/driver/availability/' + encodeURIComponent(id) + '/update';
    document.getElementById('editFromDate').value = from;
    document.getElementById('editToDate').value = to;
    document.getElementById('editStatus').value = status;
    modal.style.display = 'flex';
  }

  function closeEditModal() {
    document.getElementById('editModal').style.display = 'none';
  }

  // Close modal when clicking on backdrop
  window.onclick = function(event) {
    const modal = document.getElementById('editModal');
    if (event.target === modal) {
      closeEditModal();
    }
  };
</script>

<%- include('partials/footer') %>
