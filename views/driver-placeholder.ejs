<%- include('partials/head', { title: title || 'Driver Portal' }) %>
<%- include('partials/navbar', { activePage: typeof activeTab !== 'undefined' ? activeTab : 'dashboard' }) %>

<main style="padding: 4rem 0;">
  <div class="container" style="max-width: 600px; text-align: center;">
    <div class="card" style="padding: 3rem 2rem;">
      <div style="font-size: 3.5rem; margin-bottom: 1.25rem;"><%= typeof icon !== 'undefined' ? icon : '🚐' %></div>
      <% if (typeof phase !== 'undefined' && phase) { %>
        <span class="badge badge-pending" style="margin-bottom: 1rem;"><%= phase %></span>
      <% } %>
      <h2 style="font-size: 1.6rem; color: var(--primary-900); margin-bottom: 0.8rem;"><%= title %></h2>
      <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6; margin-bottom: 2rem;"><%= description %></p>
      <a href="/driver/dashboard" class="btn btn-primary">&larr; Back to Driver Dashboard</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
