<%- include('partials/head', { title: 'Driver Dashboard' }) %>
<%- include('partials/navbar', { activePage: 'dashboard' }) %>

<main style="padding: 2.5rem 0 4rem;">
  <div class="container">
    <%- include('partials/flash') %>

    <!-- TOP HEADER -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
      <div>
        <div style="display: flex; align-items: center; gap: 10px;">
          <h1 style="font-size: 1.85rem; color: var(--primary-900);">
            Welcome back, <%= driver.name || user.email %>
          </h1>
          <% if (driver.verificationStatus === 'verified') { %>
            <span class="badge badge-active">✓ Verified Driver</span>
          <% } else { %>
            <span class="badge badge-pending">● Verification Pending</span>
          <% } %>
        </div>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">
          Manage your availability schedule, explore matching tourist trips, and review accepted bookings.
        </p>
      </div>

      <div>
        <a href="/driver/trips" class="btn btn-primary">
          🔍 Browse Trip Marketplace (<%= matchingTripsCount %>)
        </a>
      </div>
    </div>

    <!-- DRIVER ACTIVE STATUS BANNER -->
    <div class="card" style="margin-bottom: 2rem; border-left: 5px solid <%= driver.isActive ? 'var(--teal-600)' : 'var(--border-subtle)' %>;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem;">
        <div>
          <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">
            Marketplace Discovery Status
          </div>
          <div style="display: flex; align-items: center; gap: 10px;">
            <h2 style="font-size: 1.35rem; color: var(--primary-900);">
              <%= driver.isActive ? 'Available for Trip Matching' : 'Not Currently Accepting Trip Matches' %>
            </h2>
            <span class="badge <%= driver.isActive ? 'badge-active' : 'badge-inactive' %>">
              <%= driver.isActive ? '● Active' : '● Paused' %>
            </span>
          </div>
          <p style="font-size: 0.92rem; color: var(--text-muted); margin-top: 6px; max-width: 680px;">
            <%= driver.isActive 
              ? 'Your profile is active. You can discover and accept tourist trip requests that match your van capacity and scheduled availability.' 
              : 'You are temporarily paused from receiving trip matches. Activate your profile when you are ready to accept trips.' %>
          </p>
        </div>

        <form action="/driver/toggle-active" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn <%= driver.isActive ? 'btn-outline' : 'btn-secondary' %>">
            <%= driver.isActive ? '⏸️ Pause Receiving Trips' : '▶️ Activate Profile' %>
          </button>
        </form>
      </div>
    </div>

    <!-- METRICS GRID -->
    <div class="stats-grid">
      <div class="stat-card">
        <div>
          <div class="stat-label">Matching Trips</div>
          <div class="stat-value" style="color: var(--teal-600);"><%= matchingTripsCount %></div>
        </div>
        <div class="stat-icon">🧭</div>
      </div>

      <div class="stat-card">
        <div>
          <div class="stat-label">Accepted Trips</div>
          <div class="stat-value" style="color: var(--primary-600);"><%= acceptedTripsCount %></div>
        </div>
        <div class="stat-icon">🤝</div>
      </div>

      <div class="stat-card">
        <div>
          <div class="stat-label">Availability Windows</div>
          <div class="stat-value"><%= totalAvailabilities %></div>
        </div>
        <div class="stat-icon">📅</div>
      </div>

      <div class="stat-card">
        <div>
          <div class="stat-label">Van Capacity</div>
          <div class="stat-value"><%= driver.seatingCapacity %> Seats</div>
        </div>
        <div class="stat-icon">🚐</div>
      </div>
    </div>

    <!-- TWO COLUMN OPERATIONAL OVERVIEW -->
    <div style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 2rem; align-items: start;">
      <!-- UPCOMING AVAILABILITY PREVIEW -->
      <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
          <h2 style="font-size: 1.2rem; color: var(--primary-900);">Upcoming Availability Windows</h2>
          <a href="/driver/availability" class="btn btn-outline btn-sm">+ Manage Dates</a>
        </div>

        <% if (availabilities.length === 0) { %>
          <div class="empty-state" style="padding: 2.5rem 1rem;">
            <div class="empty-icon" style="font-size: 2.2rem;">📆</div>
            <h3 class="empty-title" style="font-size: 1.05rem;">No upcoming availability scheduled</h3>
            <p class="empty-desc" style="font-size: 0.88rem;">Add your working dates so tourist requests can match with your van.</p>
            <a href="/driver/availability" class="btn btn-secondary btn-sm">+ Set Working Dates</a>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table>
              <thead>
                <tr>
                  <th>From Date</th>
                  <th>To Date</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% availabilities.slice(0, 5).forEach((p) => { %>
                  <tr>
                    <td style="font-weight: 600;"><%= p.fromDate %></td>
                    <td style="font-weight: 600;"><%= p.toDate %></td>
                    <td>
                      <% if (p.status === 'available') { %>
                        <span class="badge badge-accepted">Available</span>
                      <% } else { %>
                        <span class="badge badge-inactive">Unavailable</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- VEHICLE & DRIVER SUMMARY CARD -->
      <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
          <h2 style="font-size: 1.2rem; color: var(--primary-900);">Registered Van Details</h2>
          <a href="/driver/profile" class="btn btn-outline btn-sm">Edit Profile</a>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1rem; font-size: 0.92rem;">
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
            <span style="color: var(--text-muted);">Vehicle Model:</span>
            <strong style="color: var(--primary-900);"><%= driver.vanModel %></strong>
          </div>

          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
            <span style="color: var(--text-muted);">Registration Plate:</span>
            <strong style="color: var(--primary-900);"><%= driver.vanNumber %></strong>
          </div>

          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
            <span style="color: var(--text-muted);">Passenger Capacity:</span>
            <strong><%= driver.seatingCapacity %> Seats</strong>
          </div>

          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
            <span style="color: var(--text-muted);">Driving Experience:</span>
            <strong><%= driver.experienceYears %> Years</strong>
          </div>

          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
            <span style="color: var(--text-muted);">Driver License:</span>
            <span><%= driver.licenseNumber %></span>
          </div>

          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Contact Phone:</span>
            <strong style="color: var(--primary-700);"><%= driver.phone %></strong>
          </div>
        </div>

        <div style="margin-top: 1.5rem; background-color: var(--bg-canvas); border-radius: var(--radius-md); padding: 1rem; font-size: 0.85rem; color: var(--text-muted); line-height: 1.5;">
          ℹ️ Your vehicle details are snapshot into trip records when you accept requests so tourists have your confirmed specs.
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
