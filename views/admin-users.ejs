<%- include('partials/head', { title: 'Platform Users' }) %>
<%- include('partials/navbar', { activePage: 'admin-users' }) %>

<main style="padding: 2.5rem 0 4rem;">
  <div class="container" style="max-width: 900px;">
    <%- include('partials/flash') %>

    <!-- PAGE HEADER -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
      <div>
        <h1 style="font-size: 1.85rem; color: var(--primary-900); margin: 0;">
          Platform Users Registry
        </h1>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">
          Auditing of all registered traveler, van driver, and administrative accounts.
        </p>
      </div>

      <a href="/admin" class="btn btn-outline btn-sm">
        &larr; Back to Admin Overview
      </a>
    </div>

    <!-- FILTER TABS -->
    <div class="card" style="margin-bottom: 2rem; padding: 1.25rem;">
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <a href="/admin/users?role=all" class="btn <%= !currentFilter || currentFilter === 'all' ? 'btn-primary' : 'btn-outline' %> btn-sm">
          All Users (<%= usersList.length %>)
        </a>
        <a href="/admin/users?role=tourist" class="btn <%= currentFilter === 'tourist' ? 'btn-primary' : 'btn-outline' %> btn-sm">
          👤 Tourists
        </a>
        <a href="/admin/users?role=driver" class="btn <%= currentFilter === 'driver' ? 'btn-primary' : 'btn-outline' %> btn-sm">
          🚐 Van Drivers
        </a>
        <a href="/admin/users?role=admin" class="btn <%= currentFilter === 'admin' ? 'btn-primary' : 'btn-outline' %> btn-sm">
          🛡️ Administrators
        </a>
      </div>
    </div>

    <!-- USERS TABLE -->
    <div class="card">
      <% if (usersList.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">👥</div>
          <h3 class="empty-state-title">No Users Found</h3>
          <p class="empty-state-desc">
            No accounts match the selected role filter.
          </p>
          <a href="/admin/users" class="btn btn-outline">Reset Filter</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Account Email</th>
                <th>Role</th>
                <th>User UID</th>
                <th>Registered Date</th>
              </tr>
            </thead>
            <tbody>
              <% usersList.forEach((u) => { %>
                <% const regDate = u.createdAt ? (typeof u.createdAt.toDate === 'function' ? u.createdAt.toDate().toLocaleDateString() : new Date(u.createdAt).toLocaleDateString()) : 'N/A'; %>
                <tr>
                  <td style="font-weight: 600; color: var(--primary-900);">
                    <%= u.email %>
                  </td>
                  <td>
                    <% if (u.role === 'admin') { %>
                      <span class="badge" style="background: #e0e7ff; color: #3730a3; font-weight: 700;">🛡️ Admin</span>
                    <% } else if (u.role === 'driver') { %>
                      <span class="badge" style="background: #e0f2fe; color: #0369a1; font-weight: 700;">🚐 Van Driver</span>
                    <% } else { %>
                      <span class="badge" style="background: #f1f5f9; color: #475569; font-weight: 600;">👤 Tourist</span>
                    <% } %>
                  </td>
                  <td>
                    <code style="font-size: 0.8rem; background: var(--bg-alt); padding: 2px 6px; border-radius: 4px;"><%= u.id %></code>
                  </td>
                  <td style="font-size: 0.85rem; color: var(--text-muted);">
                    <%= regDate %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

