# ==========================================
# Destination Paradise — Environment Configuration
# ==========================================

# Server Port (default: 3000)
PORT=3000

# Environment Mode: 'development' or 'production'
# In production, secure cookies and HSTS headers are enabled
NODE_ENV=development

# Firebase Web API Key (Used for Google Identity Toolkit auth requests)
FIREBASE_API_KEY=your_firebase_web_api_key_here

# Express Session Secret (Used for signing cookies and CSRF protection)
# Generate a strong 32+ character random secret in production
SESSION_SECRET=your_strong_session_secret_here

# Optional: Path to Firebase Service Account Key JSON
# Defaults to ./key.json in project root if present
# GOOGLE_APPLICATION_CREDENTIALS=./key.json
