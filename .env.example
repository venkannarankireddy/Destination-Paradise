# ==========================================
# Destination Paradise — Environment Configuration
# ==========================================

# Server Port (default: 3000)
PORT=3000

# Environment Mode: 'development' or 'production'
# In production, secure cookies, strict configuration validation, and JSON logging are enabled
NODE_ENV=development

# Reverse Proxy Trust Configuration
# Set to '1' when deployed behind 1 reverse proxy / load balancer hop (e.g. Nginx, ALB, Cloudflare)
# Set to '2' if behind 2 hops (e.g. Cloudflare -> ALB -> Node), or supply subnet (e.g. 'loopback, 10.0.0.0/8')
TRUST_PROXY=1

# Application Timezone (default: Asia/Colombo)
APP_TIMEZONE=Asia/Colombo

# Firebase Web API Key (Used for Google Identity Toolkit auth requests)
FIREBASE_API_KEY=your_firebase_web_api_key_here

# Express Session Secret (Used for signing cookies and CSRF protection)
# REQUIRED in production mode: must be a random secret of at least 32 characters
# (e.g. generate with: openssl rand -hex 32)
SESSION_SECRET=your_strong_32_character_session_secret_here

# Optional: Path to Firebase Service Account Key JSON
# Defaults to ./key.json in project root if present
# GOOGLE_APPLICATION_CREDENTIALS=./key.json
# Or raw JSON string:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Rate Limiting Configuration (requests per 15-minute window)
AUTH_RATE_LIMIT=50
ACTION_RATE_LIMIT=120

# Operational Infrastructure & Shutdown
# Graceful shutdown timeout in milliseconds before forcing process termination
SHUTDOWN_TIMEOUT_MS=10000

# Readiness check cache duration in milliseconds (prevents hammering Firestore from load balancer probes)
READINESS_CACHE_TTL_MS=5000

# Log Level: 'info', 'warn', 'error', 'debug'
LOG_LEVEL=info
